OCWORLD 1
NAME VehicleLab
SPAWN -600 0 150 0
SUN elev 48.0 azim 130.0 color 1 0.97 0.92 lux 90000
SKY model physical
# Engine test content for the VEHICLES wave (docs/VEHICLES.md). Not a demo game. Every static shape is the built-in unit cube
# (Meshes/cube.ocmesh, half-extent 1 cm: the last three numbers of a PLACEG are half extents in centimetres); the vehicles and the crash
# panel are procedural meshes from make_vehicle_lab.py. +X is forward from the spawn. README.md has the checks.
# The default pawn flies. To drive: Play, select a vehicle, Details > Vehicle > Drive, then the Drive.* keys (W A S D, Space, E / Q, F, R, C).
PLACEG Meshes/cube.ocmesh 3000 0 -50 0 0 0 9000 4500 50 name Floor

# The vehicles, in a row along Y at x = 0 (the row the spawn looks along).
PLACE Meshes/Hatchback.ocmesh 0 -450 5 0 0 0 1 nocollide name Hatchback
  COMPONENT Vehicle asset=Vehicles/Hatchback.ocvehicle
  BEGIN
    CHILD Meshes/HatchWheel.ocmesh 125 -72 30 0 0 0 1 nocollide name WheelFL
    CHILD Meshes/HatchWheel.ocmesh 125 72 30 0 0 0 1 nocollide name WheelFR
    CHILD Meshes/HatchWheel.ocmesh -115 -72 30 0 0 0 1 nocollide name WheelRL
    CHILD Meshes/HatchWheel.ocmesh -115 72 30 0 0 0 1 nocollide name WheelRR
  END
PLACE Meshes/Truck.ocmesh 0 -1100 5 0 0 0 1 nocollide name Truck
  COMPONENT Vehicle asset=Vehicles/Truck6x4.ocvehicle
  BEGIN
    CHILD Meshes/TruckWheel.ocmesh 300 -110 50 0 0 0 1 nocollide name WheelFL
    CHILD Meshes/TruckWheel.ocmesh 300 110 50 0 0 0 1 nocollide name WheelFR
    CHILD Meshes/TruckWheel.ocmesh -100 -110 50 0 0 0 1 nocollide name WheelM1L
    CHILD Meshes/TruckWheel.ocmesh -100 110 50 0 0 0 1 nocollide name WheelM1R
    CHILD Meshes/TruckWheel.ocmesh -300 -110 50 0 0 0 1 nocollide name WheelR1L
    CHILD Meshes/TruckWheel.ocmesh -300 110 50 0 0 0 1 nocollide name WheelR1R
  END
PLACE Meshes/TankHull.ocmesh 0 450 5 0 0 0 1 nocollide name Tank
  COMPONENT Vehicle asset=Vehicles/Tank.ocvehicle
  BEGIN
    CHILD Meshes/TankWheel.ocmesh -280 -130 40 0 0 0 1 nocollide name WheelL0
    CHILD Meshes/TankWheel.ocmesh -140 -130 40 0 0 0 1 nocollide name WheelL1
    CHILD Meshes/TankWheel.ocmesh 0 -130 40 0 0 0 1 nocollide name WheelL2
    CHILD Meshes/TankWheel.ocmesh 140 -130 40 0 0 0 1 nocollide name WheelL3
    CHILD Meshes/TankWheel.ocmesh 280 -130 40 0 0 0 1 nocollide name WheelL4
    CHILD Meshes/TankWheel.ocmesh -280 130 40 0 0 0 1 nocollide name WheelR0
    CHILD Meshes/TankWheel.ocmesh -140 130 40 0 0 0 1 nocollide name WheelR1
    CHILD Meshes/TankWheel.ocmesh 0 130 40 0 0 0 1 nocollide name WheelR2
    CHILD Meshes/TankWheel.ocmesh 140 130 40 0 0 0 1 nocollide name WheelR3
    CHILD Meshes/TankWheel.ocmesh 280 130 40 0 0 0 1 nocollide name WheelR4
    CHILD Meshes/TankTurret.ocmesh 30 0 130 0 0 0 1 nocollide name Turret
  END
PLACE Meshes/RiggedCar.ocmesh 0 1100 5 0 0 0 1 nocollide name RiggedCar
  COMPONENT SkeletalMesh skeleton=Meshes/RiggedCar.ocskel
  COMPONENT ControlRig rig=Rigs/RiggedCar.ocrig
  COMPONENT Vehicle asset=Vehicles/RiggedCar.ocvehicle

# The ice-split lane, 40 m long from x = 800, along y = 2000: two strips side by side, IceLeft under a car's left wheels (y 1840..2000)
# and TarmacRight under its right ones (2000..2160). A second Hatchback waits at its start. The level format has no friction key, so make
# the ice by hand: select IceLeft, Details > Add Component > Rigid Body, Static, friction 0.05; leave TarmacRight as it is. Then drive
# Hatchback2 along +X and compare AXLE 1's `diff open | lsd | locked` (README.md).
PLACE Meshes/Hatchback.ocmesh 400 2000 5 0 0 0 1 nocollide name Hatchback2
  COMPONENT Vehicle asset=Vehicles/Hatchback.ocvehicle
  BEGIN
    CHILD Meshes/HatchWheel.ocmesh 125 -72 30 0 0 0 1 nocollide name WheelFL
    CHILD Meshes/HatchWheel.ocmesh 125 72 30 0 0 0 1 nocollide name WheelFR
    CHILD Meshes/HatchWheel.ocmesh -115 -72 30 0 0 0 1 nocollide name WheelRL
    CHILD Meshes/HatchWheel.ocmesh -115 72 30 0 0 0 1 nocollide name WheelRR
  END
PLACEG Meshes/cube.ocmesh 2800 1920 1 0 0 0 2000 80 1 name IceLeft
PLACEG Meshes/cube.ocmesh 2800 2080 1 0 0 0 2000 80 1 name TarmacRight

# A brake test strip along y = -1800: a post every 10 m from x = 800 (the post's name is the distance from the first one, in metres).
PLACEG Meshes/cube.ocmesh 800 -1800 40 0 0 0 10 60 40 name Brake0m
PLACEG Meshes/cube.ocmesh 1800 -1800 40 0 0 0 10 60 40 name Brake10m
PLACEG Meshes/cube.ocmesh 2800 -1800 40 0 0 0 10 60 40 name Brake20m
PLACEG Meshes/cube.ocmesh 3800 -1800 40 0 0 0 10 60 40 name Brake30m
PLACEG Meshes/cube.ocmesh 4800 -1800 40 0 0 0 10 60 40 name Brake40m
PLACEG Meshes/cube.ocmesh 5800 -1800 40 0 0 0 10 60 40 name Brake50m

# A drop for the landing event: a 3 m platform (top at z = 300, edge at x = 6200) with a 20 m ramp up to it. Drive off the edge.
PLACEG Meshes/cube.ocmesh 3000 450 140 0 -8.53 0 1011 600 10 name DropRamp
PLACEG Meshes/cube.ocmesh 5100 450 150 0 0 0 1100 600 150 name DropPlatform

# A slalom: twelve posts 6 m apart along y = -2600, alternately 1.3 m either side of it.
PLACEG Meshes/cube.ocmesh 1000 -2470 70 0 0 0 20 20 70 name Slalom1
PLACEG Meshes/cube.ocmesh 1600 -2730 70 0 0 0 20 20 70 name Slalom2
PLACEG Meshes/cube.ocmesh 2200 -2470 70 0 0 0 20 20 70 name Slalom3
PLACEG Meshes/cube.ocmesh 2800 -2730 70 0 0 0 20 20 70 name Slalom4
PLACEG Meshes/cube.ocmesh 3400 -2470 70 0 0 0 20 20 70 name Slalom5
PLACEG Meshes/cube.ocmesh 4000 -2730 70 0 0 0 20 20 70 name Slalom6
PLACEG Meshes/cube.ocmesh 4600 -2470 70 0 0 0 20 20 70 name Slalom7
PLACEG Meshes/cube.ocmesh 5200 -2730 70 0 0 0 20 20 70 name Slalom8
PLACEG Meshes/cube.ocmesh 5800 -2470 70 0 0 0 20 20 70 name Slalom9
PLACEG Meshes/cube.ocmesh 6400 -2730 70 0 0 0 20 20 70 name Slalom10
PLACEG Meshes/cube.ocmesh 7000 -2470 70 0 0 0 20 20 70 name Slalom11
PLACEG Meshes/cube.ocmesh 7600 -2730 70 0 0 0 20 20 70 name Slalom12

# A crash wall at x = 7200 with a Destructible panel filling the gap in it (Meshes/CrashPanel.ocmesh: a subdivided box, so there are triangles
# to tear). Drive into the panel at speed: the vehicle takes damage (health, Crash event) and the panel dents and tears (docs/SOFTBODY.md).
PLACEG Meshes/cube.ocmesh 7200 -1000 100 0 0 0 20 700 100 name CrashWallLeft
PLACEG Meshes/cube.ocmesh 7200 800 100 0 0 0 20 500 100 name CrashWallRight
PLACE Meshes/CrashPanel.ocmesh 7200 0 100 0 0 0 1 nocollide name CrashPanel
  COMPONENT Destructible preset=wood

# A 15 degree, 8 m ramp for the tank (it should climb and come down without flipping).
PLACEG Meshes/cube.ocmesh 1400 2800 90 0 -15 0 400 200 20 name TankRamp
