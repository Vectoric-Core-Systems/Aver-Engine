OCWORLD 1
NAME SoftBodyLab
GROUND 0.0 0
KILLZ -5000.0
SPAWN -100 0 100 0
# Nothing here is a third-party asset: every mesh is generated by make_soft_lab.py. The .ocmesh files appear
# after the OBJ import in README.md; until then the placements draw nothing.
# Everything stands 300 cm ahead of the spawn, in a row along Y: flag, curtain, mannequin with cape, glass pane,
# steel door, crate.
# Static dressing: a pole for the flag, a lintel for the curtain, a post under the mannequin.
PLACE Meshes/Pole.ocmesh 300 -700 -1 0 0 0 1 name FlagPole
PLACE Meshes/Lintel.ocmesh 300 -350 0 0 0 0 1 name CurtainLintel
PLACE Meshes/Pole.ocmesh 300 0 -200 0 0 0 1 name MannequinPost
PLACE Meshes/Mannequin.ocmesh 300 0 0 0 0 0 1 nocollide name Mannequin
# Cloth: a flag (light, hangs from the pole edge), a curtain (heavy, hangs from the lintel), a tearable cape.
PLACE Meshes/Flag.ocmesh 300 -700 200 0 0 0 1 nocollide name Flag
  COMPONENT Cloth asset=Soft/Flag.ocsoft preset=cloth_light
PLACE Meshes/Curtain.ocmesh 300 -350 10 0 0 0 1 nocollide name Curtain
  COMPONENT Cloth asset=Soft/Curtain.ocsoft preset=cloth_heavy
PLACE Meshes/Cape.ocmesh 286 0 80 0 0 0 1 nocollide name Cape
  COMPONENT Cloth asset=Soft/Cape.ocsoft preset=cloth_heavy tearable=1
# Destructibles: a glass pane pinned at its corners, a steel door hinged on one edge, a crate dropped from 3 m.
PLACE Meshes/GlassPane.ocmesh 300 350 0 0 0 0 1 nocollide name GlassPane
  COMPONENT Destructible asset=Soft/GlassPane.ocsoft preset=glass
PLACE Meshes/SteelDoor.ocmesh 300 700 0 0 0 0 1 nocollide name SteelDoor
  COMPONENT Destructible asset=Soft/SteelDoor.ocsoft preset=metal
PLACE Meshes/PlankCrate.ocmesh 300 1000 300 0 0 0 1 nocollide name PlankCrate
  COMPONENT Destructible asset=Soft/PlankCrate.ocsoft preset=wood
# Wave 10 (docs/plans/wave10/SOFTBODY_DEPTH.md): a 12000-triangle door over the particle cap. It has no .ocsoft yet: select it,
# Create .ocsoft, then Create proxy cage in Details (README.md step 5), and press Play.
PLACE Meshes/HighPolyDoor.ocmesh 300 1300 0 0 0 0 1 nocollide name HighPolyDoor
  COMPONENT Destructible preset=metal
