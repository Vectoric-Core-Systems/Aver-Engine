OCWORLD 1
NAME PhysicsShapesLab
SPAWN -600 0 150 0
SUN elev 48.0 azim 130.0 color 1 0.97 0.92 lux 90000
SKY model physical
# Engine test content for SHAPES_MATERIALS (docs/PHYSICS_SHAPES.md). Not a demo game. The stand-ins are the built-in unit cube
# (Meshes/cube.ocmesh, half-extent 1 cm: PLACE's scale is the half extent in centimetres); the four meshes are procedural, from make_shapes_lab.py.
# A COMPONENT CollisionShape names the .ocshape that gives the placement its collision (the stand-in cube is only what you SEE; turn on
# Show > Collision Shapes to see what collides). `motion=dynamic` makes it fall: no level file carries a Rigid Body, so the record does. +X is forward.
# A stand-in cube is scaled to its size, and a body is built at the entity's world scale unless `noscale=1`: the cubes say noscale, the meshes (scale 1) do not.
# CRigidBody has no pose write-back (docs/PHYSICS_SHAPES.md), so a dynamic body falls INVISIBLY: its cube stays where it was placed. Watch the wire.
PLACEG Meshes/cube.ocmesh 3000 0 -50 0 0 0 9000 4500 50 name Floor

# The shape row along y = -1000..1000 at x = 0 (the spawn looks along +X), dropped from 1.2 m so the fall is visible.
PLACE Meshes/cube.ocmesh 0 -1000 120 0 0 0 40 nocollide name Chair
  COMPONENT CollisionShape asset=Physics/Chair.ocshape surface=Wood motion=dynamic noscale=1
PLACE Meshes/cube.ocmesh 0 -600 150 0 0 0 28 nocollide name Barrel
  COMPONENT CollisionShape asset=Physics/Barrel.ocshape surface=Metal motion=dynamic noscale=1
PLACE Meshes/cube.ocmesh 0 -200 100 0 0 0 25 nocollide name GrowCrate
  COMPONENT CollisionShape asset=Physics/GrowCrate.ocshape surface=Wood motion=dynamic noscale=1
PLACE Meshes/LabRock.ocmesh 0 200 120 0 0 0 1 nocollide name RockHull
  COMPONENT CollisionShape asset=Physics/RockHull.ocshape surface=Gravel motion=dynamic
PLACE Meshes/LabBarrelMesh.ocmesh 0 600 200 0 0 0 1 nocollide name MeshPropOnFloor
  COMPONENT CollisionShape asset=Physics/MeshProp.ocshape motion=dynamic
PLACE Meshes/cube.ocmesh 0 1000 0 0 0 0 1 nocollide name PlaneRamp
  COMPONENT CollisionShape asset=Physics/PlaneRamp.ocshape
PLACE Meshes/cube.ocmesh 150 1000 120 0 -30 0 20 nocollide name PlaneCrate
  COMPONENT CollisionShape asset=Physics/Crate.ocshape motion=dynamic noscale=1

# The two-slot floor (800 x 400 cm, ice on the left half, rubber on the right): its collision mesh carries each slot's surface, so a probe
# (Details > Collision Shape > Probe below the entity, or an `an_surfacebeneath` node) reports Ice on the left and Rubber on the right.
# A mesh prop dropped on it falls THROUGH (mesh vs mesh does not collide: the documented limit).
PLACE Meshes/LabFloorTwoSlot.ocmesh 2000 0 1 0 0 0 1 name TwoSlotFloor
PLACE Meshes/LabBarrelMesh.ocmesh 2000 100 300 0 0 0 1 nocollide name MeshPropOnMesh
  COMPONENT CollisionShape asset=Physics/MeshProp.ocshape motion=dynamic

# The three-lane ramp, 900 cm long and falling about 20 degrees towards +X: ice (y -150..-50), rubber (-50..50), metal (50..150). A crate sits
# at the top of each lane: the ice crate slides away, the metal crate creeps, the rubber crate holds. Lower Rubber's friction in
# Project Settings > Physics > Surfaces while it plays and the next slide changes.
PLACE Meshes/LabRamp.ocmesh 3200 0 0.5 0 0 0 1 name Ramp
PLACE Meshes/cube.ocmesh 3250 -100 335 0 20 0 20 nocollide name CrateIce
  COMPONENT CollisionShape asset=Physics/Crate.ocshape motion=dynamic noscale=1
PLACE Meshes/cube.ocmesh 3250 0 335 0 20 0 20 nocollide name CrateRubber
  COMPONENT CollisionShape asset=Physics/Crate.ocshape motion=dynamic noscale=1
PLACE Meshes/cube.ocmesh 3250 100 335 0 20 0 20 nocollide name CrateMetal
  COMPONENT CollisionShape asset=Physics/Crate.ocshape motion=dynamic noscale=1

