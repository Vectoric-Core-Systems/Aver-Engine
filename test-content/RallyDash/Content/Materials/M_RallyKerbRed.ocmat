OCMAT 1
# M_RallyKerbRed: authored by make_rally_dash.py (flat colour, no textures).
SHADER standard
BLEND opaque
CULL back
FLAGS twosided=0 castshadow=1

PARAM baseColorFactor 0.78 0.07 0.05 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.7
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
