OCMAT 1
# M_RallyLamp: authored by make_rally_dash.py (flat colour, no textures).
SHADER standard
BLEND opaque
CULL back
FLAGS twosided=0 castshadow=1

PARAM baseColorFactor 1 1 0.9 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.4
PARAM emissiveFactor 1.6 1.5 1.2
PARAM normalScale 1
PARAM occlusionStrength 1
