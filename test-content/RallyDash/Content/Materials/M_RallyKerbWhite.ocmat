OCMAT 1
# M_RallyKerbWhite: authored by make_rally_dash.py (flat colour, no textures).
SHADER standard
BLEND opaque
CULL back
FLAGS twosided=0 castshadow=1

PARAM baseColorFactor 0.9 0.9 0.88 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.7
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
