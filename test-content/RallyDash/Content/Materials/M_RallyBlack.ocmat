OCMAT 1
# M_RallyBlack: authored by make_rally_dash.py (flat colour, no textures).
SHADER standard
BLEND opaque
CULL back
FLAGS twosided=0 castshadow=1

PARAM baseColorFactor 0.02 0.02 0.02 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.8
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
