OCMAT 1
# M_RallyGold: authored by make_rally_dash.py (flat colour, no textures).
SHADER standard
BLEND opaque
CULL back
FLAGS twosided=0 castshadow=1

PARAM baseColorFactor 0.9 0.62 0.05 1
PARAM metallicFactor 0.3
PARAM roughnessFactor 0.35
PARAM emissiveFactor 0.9 0.55 0
PARAM normalScale 1
PARAM occlusionStrength 1
