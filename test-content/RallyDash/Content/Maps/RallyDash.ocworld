# The player's car: COMPONENT Vehicle (Vehicles/Sedan.ocvehicle) plus a chase COMPONENT CameraRig; its four wheels are CHILD placements the
# vehicle system moves every frame (the spec's `node` names). nocollide: the physics vehicle is the chassis.
PLACE Meshes/Sedan.ocmesh 9337.37 4548.84 12 149.7 0 0 1 M_RallyCarRed nocollide name Sedan
  COMPONENT Vehicle asset=Vehicles/Sedan.ocvehicle
  COMPONENT CameraRig preset=vehiclechase arm=700 collision=0
  BEGIN
    CHILD Meshes/Wheel.ocmesh 180 -77 33 0 0 0 1 M_RallyTyre nocollide name WheelFL
    CHILD Meshes/Wheel.ocmesh 180 77 33 0 0 0 1 M_RallyTyre nocollide name WheelFR
    CHILD Meshes/Wheel.ocmesh -180 -77 33 0 0 0 1 M_RallyTyre nocollide name WheelRL
    CHILD Meshes/Wheel.ocmesh -180 77 33 0 0 0 1 M_RallyTyre nocollide name WheelRR
  END
# Two slow traffic cars: `vehicle <asset>` makes the placement a lane-following car on RallyDash.oclanes (the right-hand lane).
PLACE Meshes/Sedan.ocmesh 2669.83 7123.48 12 164.65 0 0 1 M_RallyCarBlue nocollide vehicle Vehicles/Sedan.ocvehicle
  BEGIN
    CHILD Meshes/Wheel.ocmesh 180 -77 33 0 0 0 1 M_RallyTyre nocollide name WheelFL
    CHILD Meshes/Wheel.ocmesh 180 77 33 0 0 0 1 M_RallyTyre nocollide name WheelFR
    CHILD Meshes/Wheel.ocmesh -180 -77 33 0 0 0 1 M_RallyTyre nocollide name WheelRL
    CHILD Meshes/Wheel.ocmesh -180 77 33 0 0 0 1 M_RallyTyre nocollide name WheelRR
  END
PLACE Meshes/Sedan.ocmesh -3933.44 -6804.92 12 16.4 0 0 1 M_RallyCarYellow nocollide vehicle Vehicles/Sedan.ocvehicle
  BEGIN
    CHILD Meshes/Wheel.ocmesh 180 -77 33 0 0 0 1 M_RallyTyre nocollide name WheelFL
    CHILD Meshes/Wheel.ocmesh 180 77 33 0 0 0 1 M_RallyTyre nocollide name WheelFR
    CHILD Meshes/Wheel.ocmesh -180 -77 33 0 0 0 1 M_RallyTyre nocollide name WheelRL
    CHILD Meshes/Wheel.ocmesh -180 77 33 0 0 0 1 M_RallyTyre nocollide name WheelRR
  END
