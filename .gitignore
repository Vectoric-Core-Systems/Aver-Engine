# --- Build outputs ---
# A glob rather than one line per configuration: publishing more than one EDITION means one build
# tree per module combination (scripts/build.ps1 -BuildDir build-minimal ...), and those trees cannot
# be enumerated in advance. Staging an edition from a tree that was reconfigured in place ships stale
# output, so a tree per edition is the supported way to do it.
/build/
/build-*/
# Underscore too. The hyphen glob above misses `build_foo`, and a scratch tree named that way shows
# up as hundreds of untracked files -- which is exactly the noise that makes `git add -A` dangerous.
/build_*/
/out/
[Bb]in/
[Oo]bj/
/dist/

# --- CMake ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.cmake.stamp

# --- Rust ---
**/target/
Cargo.lock

# --- .NET / C# ---
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/

# --- Editor / OS ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
Thumbs.db
.DS_Store

# --- Third-party fetched deps (kept out of VCS; pulled by CMake) ---
/third_party/_deps/

# NRD writes its build-time configuration header back into its own source tree: the ShaderMake run
# uses third_party/nrd/Shaders as its source directory, so NRDConfig.hlsli has to live there. It is
# generated from the NRD_* CMake options (see cmake/AverNRD.cmake) and is not upstream content.
/third_party/nrd/Shaders/NRDConfig.hlsli
/third_party/nrd/_Shaders/

# C# scripting build output
scripting/**/bin/
scripting/**/obj/

# Claude Code's per-checkout folder: agent worktrees, scratch output and local tool state. All of it is
# machine-local and transient, so the whole folder stays out of VCS rather than one subfolder at a time.
.claude/

# Python bytecode, from importing tools/mcp/aver_mcp.py to test it
__pycache__/

# --- Local machine config ---
# mcp.conf: developer-local port assignments (mcp.conf.example is the committed template). Untracked
# on purpose -- see mcp.conf.example's own header -- so each checkout, including each git worktree,
# can pick its own ports without colliding or needing a merge.
/mcp.conf

# Generated by GraphEditorLoadSaveTest and then READ by the C# cross-language test. Deliberately
# not committed: a checked-in copy would let that test pass against a stale file even if the C++
# writer it is supposed to be proving had broken.
*.output.ocgraph

# BUILD OUTPUT, in test content. A .ocnav is regenerated in one command
# (`Sandbox.exe <project> --headless --frames 12 --bake-nav`), and a committed copy would let a
# change to the baker look gate-clean while the file in the tree still described the old behaviour.
# A real project's .ocnav is shipped content and is NOT covered by this -- the path is deliberate.
test-content/**/*.ocnav

# THE GI DERIVED DATA CACHE, wherever it appears. Its own header states the case: nothing in it is
# authored and nothing in it is precious -- the whole directory can be deleted at any time and the
# only cost is one rebuild. Six of these accumulated untracked under test-content/ and were pure
# `git add -A` hazards.
#
# UNANCHORED, unlike the test-content/**/*.ocnav rule just above, and the difference is deliberate.
# A .ocnav IS shippable content for a real project, so that rule is scoped to test content on
# purpose. A DerivedDataCache never is, anywhere -- it is regenerable by definition -- so there is
# no location where committing one would be right.
DerivedDataCache/
