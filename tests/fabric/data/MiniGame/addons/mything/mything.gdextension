[configuration]

entry_symbol = "mything_library_init"
compatibility_minimum = "4.1"
compatibility_maximum = "4.3"
reloadable = true

[libraries]

macos.debug = "res://addons/mything/bin/libmything.macos.template_debug.framework"
windows.debug.x86_64 = "res://addons/mything/bin/libmything.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/mything/bin/libmything.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/mything/bin/libmything.linux.template_debug.x86_64.so"

[icons]

MyNode = "res://addons/mything/icons/mynode.svg"

[dependencies]

windows.x86_64 = { "res://addons/mything/bin/helper.dll": "" }
