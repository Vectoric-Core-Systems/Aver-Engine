; Engine configuration file.
; A fixture for the patterns the Godot demo corpus showed (FabricCorpusPatternsTest, docs/plans/fabric/G3_SCENES.md): an old project's Godot 3 key codes and
; joypad numbers, empty and unmappable key events, children and overrides below the nodes of an instanced glTF model, libraries/ properties and a curve's _limits.

config_version=5

[application]

config/name="Corpus Game"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/tags=PackedStringArray("demo")

[debug]

gdscript/warnings/untyped_declaration=1

