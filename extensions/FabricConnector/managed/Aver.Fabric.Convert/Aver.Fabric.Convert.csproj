<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aver.Fabric.Convert: the GodotSharp half of the Fabric Connector (docs/plans/fabric/G3_SCRIPTS.md).

       A console tool, staged to bin/Tools beside averdesign and restored the same way: Microsoft.CodeAnalysis.CSharp 5.6.0 comes from
       the vendored third_party/nuget folder (NuGet.config names it as the only source), so the restore needs no network. It has no
       ProjectReference to the engine: it compiles the converted scripts against the Aver.Fabric.dll and Aver.Framework.dll it finds
       in a folder (bin/Scripting by default), so a tool built today still checks scripts against whatever runtime is staged.

       PINNED to the version averdesign uses, not floating: two tools in one output folder share Microsoft.CodeAnalysis.dll. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Aver.Fabric.Convert</AssemblyName>
    <RootNamespace>Aver.Fabric.Convert</RootNamespace>
    <RollForward>LatestMinor</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>

</Project>
