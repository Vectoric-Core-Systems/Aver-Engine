<Project Sdk="Microsoft.NET.Sdk">

  <!-- A sample user script assembly. This is exactly the shape a project's Scripts.csproj has:
       a plain library referencing Aver.Scripting and nothing else. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Aver.Scripting.SampleBehaviour</AssemblyName>
    <RootNamespace>Aver.Scripting.SampleBehaviour</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false asks MSBuild not to copy Aver.Scripting.dll next to this one: the engine has
         it loaded already, and a second copy in the scripts folder would be a second runtime
         identity for AverBehaviour, which the discovery test would then match nothing against.
         `dotnet build -o` copies it regardless, which is why the bridge ALSO skips it by simple
         name — the belt is what actually holds, and the braces are here so a normal `dotnet build`
         of a user project does the right thing too. -->
    <ProjectReference Include="..\Aver.Scripting\Aver.Scripting.csproj" Private="false" />
  </ItemGroup>

</Project>
