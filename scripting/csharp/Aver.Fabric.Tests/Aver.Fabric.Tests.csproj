<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aver.Fabric tests. House pattern: a console project whose Main returns the failure count (no xunit). A bare process with
       no engine library: the managed node host runs the lifecycle, so Godot's enter/ready/exit order, the signals, node paths, the
       math and the Variant rules are all checked here. Run with `dotnet run -c Debug` in this folder. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <AssemblyName>Aver.Fabric.Tests</AssemblyName>
    <RootNamespace>Aver.Fabric.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aver.Fabric\Aver.Fabric.csproj" />
    <!-- The GodotSharp script converter (G3 F3), run in process by ConvertScriptsTests against this runtime. Roslyn comes from third_party/nuget. -->
    <ProjectReference Include="..\Aver.Fabric.Convert\Aver.Fabric.Convert.csproj" />
  </ItemGroup>

</Project>
