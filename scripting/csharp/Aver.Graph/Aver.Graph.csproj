<Project Sdk="Microsoft.NET.Sdk">

  <!-- Graph runtime: parse .ocgraph text files and compile them to .NET IL using System.Reflection.Emit.
       This is a minimal slice proving the core property: a graph loaded from text, compiled to IL,
       and invoked returns the same value as hand-written C#. No canvas, no editor panel, no node
       library beyond what proves the slice. Five or six node types covering constants, arithmetic,
       comparison, and one engine P/Invoke call. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Aver.Graph</AssemblyName>
    <RootNamespace>Aver.Graph</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The graph compiler needs Scene to call P/Invoke functions through the Native binding. -->
    <ProjectReference Include="..\Aver.Scene\Aver.Scene.csproj" />
  </ItemGroup>

</Project>
