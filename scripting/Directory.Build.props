<Project>
  <!-- FSharp.Core restores from the SDK's own FSharp/library-packs folder, which the F# SDK adds as a restore source
       only for .fsproj projects. A C# project that references one (Aver.Pcg.Apply, the two F# samples) gets
       FSharp.Core transitively and, with NuGet.config's <clear/>, could find it only in a warm package cache: a clean
       machine (CI) failed with NU1101. Same folder, offline, so nothing new is fetched. -->
  <PropertyGroup>
    <RestoreAdditionalProjectSources Condition="Exists('$(MSBuildBinPath)/FSharp/library-packs')">$(RestoreAdditionalProjectSources);$(MSBuildBinPath)/FSharp/library-packs</RestoreAdditionalProjectSources>
  </PropertyGroup>
</Project>
