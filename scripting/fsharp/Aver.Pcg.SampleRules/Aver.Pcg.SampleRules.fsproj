<Project Sdk="Microsoft.NET.Sdk">

  <!-- A worked example of AUTHORED PCG RULES: the F# a project writer produces.
       Depends on Aver.Pcg and nothing else: no Aver.Scripting, no Aver.Framework, no engine. That
       is the property worth protecting: rules stay testable with no host, no device and no CLR
       bootstrap, so "same seed, same world" can be checked on CPU in milliseconds.
       The C# behaviour in Aver.Scripting.SamplePcg is what makes any of it exist in a level. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aver.Pcg.SampleRules</AssemblyName>
    <RootNamespace>Aver.Pcg.SampleRules</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Forest.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aver.Pcg\Aver.Pcg.fsproj" />
  </ItemGroup>

</Project>
