// Application icon (id 1). Path is relative to this .rc file.
1 ICON "../../branding/icon.ico"

// VERSIONINFO -- what the executable calls ITSELF.
//
// The runtime's FILE is AverEngineRuntime.exe, and this is what makes it read "Aver Engine Runtime"
// everywhere a person looks: Task Manager's Processes tab, the Details tab of file properties, and any
// installer inventory all show FileDescription rather than the filename. Modelled on sandbox/Sandbox.rc,
// which does the same for Sandbox.exe ("Aver Engine") -- see that file for why a missing VERSIONINFO was
// visible in several places at once. ProductName is the product both executables belong to.
//
// The numeric version is duplicated from sandbox/Sandbox.rc rather than generated, because a .rc is not
// configured through CMake in this tree. Change the two together.
#define AVER_VER_MAJOR 0
#define AVER_VER_MINOR 1
#define AVER_VER_PATCH 0

1 VERSIONINFO
FILEVERSION    AVER_VER_MAJOR, AVER_VER_MINOR, AVER_VER_PATCH, 0
PRODUCTVERSION AVER_VER_MAJOR, AVER_VER_MINOR, AVER_VER_PATCH, 0
FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
FILEFLAGS      0x1L                     // VS_FF_DEBUG
#else
FILEFLAGS      0x0L
#endif
FILEOS         0x40004L                 // VOS_NT_WINDOWS32
FILETYPE       0x1L                     // VFT_APP
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904b0 = US English, Unicode. The Translation value below MUST agree with this name or
        // the block is ignored wholesale and every field reads back empty again.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Aver Engine"
            VALUE "FileDescription",  "Aver Engine Runtime"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "AverEngineRuntime"
            VALUE "OriginalFilename", "AverEngineRuntime.exe"
            VALUE "ProductName",      "Aver Engine"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
