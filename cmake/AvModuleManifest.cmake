# AvModuleManifest.cmake -- modules/<dir>/module.json is the single source of truth for which modules
# exist, which can be switched off, and what each stands on. See docs/MODULES.md.
#
#   aver_load_module_manifests()      read every manifest (included below, runs at include time)
#   aver_declare_module_options()     option() for each optional module, from its manifest + the edition
#   aver_enforce_module_deps()        an enabled module needs its dependencies: error, or AUTO_DEPS
#   aver_check_module_manifests()     after every add_subdirectory: manifests vs the real targets
#
# Manifest fields this file reads: name, dir, option, required, default, editions, dependsOn,
# optionalDependsOn, derivedFrom, skeleton, platforms, description. The rest (displayName, category,
# consequence) is for the launcher; scripts/module-catalog.py validates the whole schema.
#
# Three kinds of module:
#   required  option null, "required": true  -- always built
#   optional  has an option                  -- the user's choice, bounded by the dependency rule
#   derived   option null, "derivedFrom": [M...] -- no switch of its own; built exactly when every M
#             is enabled (a scene join, a private backend). It never blocks turning anything off.

# The platform name a manifest's "platforms" list is matched against. A manifest with no "platforms"
# builds everywhere; one that lists some is treated exactly like a skeleton on every other platform:
# no option takes effect, nothing may need it, and its target must not exist.
if(WIN32)
  set(AVER_PLATFORM_NAME "windows")
elseif(APPLE)
  set(AVER_PLATFORM_NAME "macos")
else()
  set(AVER_PLATFORM_NAME "linux")
endif()

option(AVER_MODULE_AUTO_DEPS "When a module's dependency is off, turn the dependency on instead of failing to configure" OFF)

# "Aver.Render.PBR" -> "Aver_Render_PBR": a legal variable-name fragment.
function(_aver_vid out name)
  string(REPLACE "." "_" _v "${name}")
  set(${out} "${_v}" PARENT_SCOPE)
endfunction()

function(_aver_json_str out json key)
  string(JSON _v ERROR_VARIABLE _err GET "${json}" ${key})
  if(_err STREQUAL "NOTFOUND")
    set(${out} "${_v}" PARENT_SCOPE)
  else()
    set(${out} "" PARENT_SCOPE)
  endif()
endfunction()

function(_aver_json_list out json key)
  set(_l "")
  string(JSON _t ERROR_VARIABLE _err TYPE "${json}" ${key})
  if(_err STREQUAL "NOTFOUND" AND _t STREQUAL "ARRAY")
    string(JSON _n LENGTH "${json}" ${key})
    if(_n GREATER 0)
      math(EXPR _last "${_n}-1")
      foreach(_i RANGE ${_last})
        string(JSON _v GET "${json}" ${key} ${_i})
        list(APPEND _l "${_v}")
      endforeach()
    endif()
  endif()
  set(${out} "${_l}" PARENT_SCOPE)
endfunction()

# Per-module data lives in GLOBAL properties "AVER_MOD:<name>:<field>"; AVER_MOD_NAMES lists the names.
function(_aver_mod_get out name field)
  get_property(_v GLOBAL PROPERTY "AVER_MOD:${name}:${field}")
  set(${out} "${_v}" PARENT_SCOPE)
endfunction()

function(aver_load_module_manifests)
  file(GLOB _files CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/modules/*/module.json")
  set(_names "")
  foreach(_f IN LISTS _files)
    # A manifest edit must re-run configure, or the option set goes stale silently.
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_f}")
    get_filename_component(_d "${_f}" DIRECTORY)
    get_filename_component(_dir "${_d}" NAME)
    file(READ "${_f}" _j)
    _aver_json_str(_schema "${_j}" schema)
    _aver_json_str(_name "${_j}" name)
    _aver_json_str(_jdir "${_j}" dir)
    if(NOT _schema STREQUAL "1" OR _name STREQUAL "" OR NOT _jdir STREQUAL _dir)
      message(FATAL_ERROR "modules/${_dir}/module.json: needs \"schema\": 1, a \"name\", and \"dir\": \"${_dir}\"")
    endif()
    if(_name IN_LIST _names)
      message(FATAL_ERROR "modules/${_dir}/module.json: duplicate module name ${_name}")
    endif()
    list(APPEND _names "${_name}")
    set_property(GLOBAL PROPERTY "AVER_MOD:${_name}:dir" "${_dir}")
    _aver_json_str(_v "${_j}" description)
    set_property(GLOBAL PROPERTY "AVER_MOD:${_name}:description" "${_v}")
    # option is null for always-built and derived modules.
    string(JSON _t ERROR_VARIABLE _err TYPE "${_j}" option)
    set(_opt "")
    if(_err STREQUAL "NOTFOUND" AND _t STREQUAL "STRING")
      _aver_json_str(_opt "${_j}" option)
    endif()
    set_property(GLOBAL PROPERTY "AVER_MOD:${_name}:option" "${_opt}")
    foreach(_k required default skeleton)
      _aver_json_str(_v "${_j}" ${_k})
      if(_v STREQUAL "")
        set(_v OFF)
      endif()
      set_property(GLOBAL PROPERTY "AVER_MOD:${_name}:${_k}" "${_v}")
    endforeach()
    foreach(_k dependsOn optionalDependsOn derivedFrom)
      _aver_json_list(_l "${_j}" ${_k})
      set_property(GLOBAL PROPERTY "AVER_MOD:${_name}:${_k}" "${_l}")
    endforeach()
    # Not built on this platform: from here on the module is indistinguishable from a skeleton.
    _aver_json_list(_plats "${_j}" platforms)
    set(_here ON)
    if(_plats AND NOT AVER_PLATFORM_NAME IN_LIST _plats)
      set(_here OFF)
    endif()
    set_property(GLOBAL PROPERTY "AVER_MOD:${_name}:onThisPlatform" "${_here}")
    # "editions" present = the edition decides this module's default (and a re-derive resets it).
    set(_has_ed OFF)
    string(JSON _t ERROR_VARIABLE _err TYPE "${_j}" editions)
    if(_err STREQUAL "NOTFOUND" AND _t STREQUAL "OBJECT")
      set(_has_ed ON)
    endif()
    set_property(GLOBAL PROPERTY "AVER_MOD:${_name}:hasEditions" "${_has_ed}")
    foreach(_e standard slim full)
      set(_v "")
      if(_has_ed)
        string(JSON _x ERROR_VARIABLE _err GET "${_j}" editions ${_e})
        if(_err STREQUAL "NOTFOUND")
          set(_v "${_x}")
        endif()
      endif()
      set_property(GLOBAL PROPERTY "AVER_MOD:${_name}:edition_${_e}" "${_v}")
    endforeach()
  endforeach()
  list(SORT _names)
  set_property(GLOBAL PROPERTY AVER_MOD_NAMES "${_names}")
endfunction()

# The value an edition gives a module's option: its "editions" entry, else its "default".
function(_aver_edition_value out name edition)
  _aver_mod_get(_has "${name}" hasEditions)
  set(_v "")
  if(_has)
    _aver_mod_get(_v "${name}" edition_${edition})
  endif()
  if(_v STREQUAL "")
    _aver_mod_get(_v "${name}" default)
  endif()
  set(${out} "${_v}" PARENT_SCOPE)
endfunction()

# Which modules are ON right now, as _on_<id> variables in the caller's scope: required modules always,
# optional ones by their cache option, derived ones when every derivedFrom module is ON. Skeletons never.
macro(_aver_compute_state)
  get_property(_cs_names GLOBAL PROPERTY AVER_MOD_NAMES)
  foreach(_cs_m IN LISTS _cs_names)
    _aver_vid(_cs_id "${_cs_m}")
    _aver_mod_get(_cs_skel "${_cs_m}" skeleton)
    _aver_mod_get(_cs_req "${_cs_m}" required)
    _aver_mod_get(_cs_opt "${_cs_m}" option)
    _aver_mod_get(_cs_here "${_cs_m}" onThisPlatform)
    set(_on_${_cs_id} OFF)
    if(_cs_skel OR NOT _cs_here)
      # not built
    elseif(_cs_req)
      set(_on_${_cs_id} ON)
    elseif(NOT _cs_opt STREQUAL "")
      if(${_cs_opt})
        set(_on_${_cs_id} ON)
      endif()
    endif()
  endforeach()
  # Derived modules (no option, not required): a few passes settle chains of them.
  foreach(_cs_pass RANGE 3)
    foreach(_cs_m IN LISTS _cs_names)
      _aver_vid(_cs_id "${_cs_m}")
      _aver_mod_get(_cs_skel "${_cs_m}" skeleton)
      _aver_mod_get(_cs_req "${_cs_m}" required)
      _aver_mod_get(_cs_opt "${_cs_m}" option)
      _aver_mod_get(_cs_here "${_cs_m}" onThisPlatform)
      if(NOT _cs_skel AND _cs_here AND NOT _cs_req AND _cs_opt STREQUAL "")
        _aver_mod_get(_cs_from "${_cs_m}" derivedFrom)
        set(_cs_all ON)
        foreach(_cs_f IN LISTS _cs_from)
          _aver_vid(_cs_fid "${_cs_f}")
          if(NOT _on_${_cs_fid})
            set(_cs_all OFF)
          endif()
        endforeach()
        set(_on_${_cs_id} ${_cs_all})
      endif()
    endforeach()
  endforeach()
endmacro()

function(aver_declare_module_options)
  get_property(_names GLOBAL PROPERTY AVER_MOD_NAMES)

  # option() never overwrites an existing cache entry, so an edition change (or a change to what an
  # edition contains) would leave every module exactly as the previous edition set it. The stamp
  # records what the cached module set came from; when it differs, the edition-controlled modules are
  # re-derived. Bump AVER_EDITION_REVISION in the same commit that edits any "editions" entry.
  # THE COST: a re-derive overwrites a deliberate -DAVER_MODULE_X=OFF on that one configure.
  set(AVER_EDITION_REVISION "2" CACHE INTERNAL "bump when any module manifest's editions change")
  set(_stamp "${AVER_EDITION}@${AVER_EDITION_REVISION}")
  if(DEFINED AVER_EDITION_APPLIED AND NOT AVER_EDITION_APPLIED STREQUAL _stamp)
    message(STATUS "Aver: edition ${AVER_EDITION_APPLIED} -> ${_stamp}, re-deriving module set")
    foreach(_m IN LISTS _names)
      _aver_mod_get(_opt "${_m}" option)
      _aver_mod_get(_has "${_m}" hasEditions)
      if(_has AND NOT _opt STREQUAL "")
        _aver_edition_value(_v "${_m}" "${AVER_EDITION}")
        set(${_opt} ${_v} CACHE BOOL "" FORCE)
      endif()
    endforeach()
  endif()
  set(AVER_EDITION_APPLIED "${_stamp}" CACHE INTERNAL "the edition+revision the cached module set came from")

  foreach(_m IN LISTS _names)
    _aver_mod_get(_opt "${_m}" option)
    if(NOT _opt STREQUAL "")
      _aver_mod_get(_desc "${_m}" description)
      _aver_edition_value(_v "${_m}" "${AVER_EDITION}")
      option(${_opt} "${_desc}" ${_v})
      # The cache keeps whatever the user or the edition chose, so a tree moved between machines does
      # not lose it; the variable every if(${_opt}) below reads says the module is not here.
      _aver_mod_get(_here "${_m}" onThisPlatform)
      if(NOT _here)
        set(${_opt} OFF PARENT_SCOPE)
      endif()
    endif()
  endforeach()
endfunction()

# The option names that currently keep module <name> from being built ("" when it is built).
function(_aver_blockers out name)
  _aver_mod_get(_skel "${name}" skeleton)
  _aver_mod_get(_req "${name}" required)
  _aver_mod_get(_opt "${name}" option)
  _aver_mod_get(_here "${name}" onThisPlatform)
  set(_r "")
  if(_skel)
    set(_r "(planned, not built)")
  elseif(NOT _here)
    set(_r "(not built on ${AVER_PLATFORM_NAME})")
  elseif(_req)
    # always built
  elseif(NOT _opt STREQUAL "")
    if(NOT ${_opt})
      set(_r "${_opt}=OFF")
    endif()
  else()
    _aver_mod_get(_from "${name}" derivedFrom)
    foreach(_f IN LISTS _from)
      _aver_blockers(_b "${_f}")
      list(APPEND _r ${_b})
    endforeach()
  endif()
  set(${out} "${_r}" PARENT_SCOPE)
endfunction()

# Switch on whatever builds <name>: its option, or for a derived module the modules it derives from.
function(_aver_enable_module name needed_by)
  _aver_mod_get(_opt "${name}" option)
  if(NOT _opt STREQUAL "")
    if(NOT ${_opt})
      set(${_opt} ON CACHE BOOL "" FORCE)
      message(STATUS "Aver: AVER_MODULE_AUTO_DEPS: ${_opt}=ON (${needed_by} needs ${name})")
      set_property(GLOBAL PROPERTY AVER_MOD_CHANGED ON)
    endif()
  else()
    _aver_mod_get(_from "${name}" derivedFrom)
    foreach(_f IN LISTS _from)
      _aver_enable_module("${_f}" "${needed_by}")
    endforeach()
  endif()
endfunction()

function(aver_enforce_module_deps)
  get_property(_names GLOBAL PROPERTY AVER_MOD_NAMES)
  set(_violations "")
  set(_fix_on "")
  set(_fix_off "")
  set(_guard 0)
  set(_again ON)
  while(_again AND _guard LESS 40)
    math(EXPR _guard "${_guard}+1")
    set(_again OFF)
    set(_violations "")
    set(_fix_on "")
    set(_fix_off "")
    set_property(GLOBAL PROPERTY AVER_MOD_CHANGED OFF)
    _aver_compute_state()
    foreach(_m IN LISTS _names)
      _aver_vid(_id "${_m}")
      if(NOT _on_${_id})
        continue()
      endif()
      _aver_mod_get(_deps "${_m}" dependsOn)
      _aver_mod_get(_mopt "${_m}" option)
      foreach(_d IN LISTS _deps)
        _aver_vid(_did "${_d}")
        get_property(_known GLOBAL PROPERTY "AVER_MOD:${_d}:dir")
        if(NOT _known)
          message(FATAL_ERROR "module.json of ${_m}: dependsOn names ${_d}, which no modules/*/module.json defines")
        endif()
        if(_on_${_did})
          continue()
        endif()
        _aver_mod_get(_dhere "${_d}" onThisPlatform)
        if(AVER_MODULE_AUTO_DEPS AND _dhere)
          _aver_enable_module("${_d}" "${_m}")
        else()
          _aver_blockers(_b "${_d}")
          string(REPLACE "=OFF" "" _bopts "${_b}")
          set(_who "${_m}")
          if(NOT _mopt STREQUAL "")
            set(_who "${_m} (${_mopt}=ON)")
          endif()
          list(APPEND _violations "${_who} needs ${_d}, which is off (${_b})")
          list(APPEND _fix_on ${_bopts})
          if(NOT _mopt STREQUAL "")
            list(APPEND _fix_off ${_mopt})
          endif()
        endif()
      endforeach()
    endforeach()
    get_property(_changed GLOBAL PROPERTY AVER_MOD_CHANGED)
    if(_changed)
      set(_again ON)
    endif()
  endwhile()

  if(_violations)
    list(REMOVE_DUPLICATES _fix_on)
    list(REMOVE_DUPLICATES _fix_off)
    string(REPLACE ";" "\n    " _vtext "${_violations}")
    set(_ontext "")
    foreach(_o IN LISTS _fix_on)
      string(APPEND _ontext " -D${_o}=ON")
    endforeach()
    set(_offtext "")
    foreach(_o IN LISTS _fix_off)
      string(APPEND _offtext " -D${_o}=OFF")
    endforeach()
    message(FATAL_ERROR
      "Module dependencies: an enabled module needs a module that is switched off:\n"
      "    ${_vtext}\n"
      "  Fix it one of three ways:\n"
      "    turn the dependencies on:   ${_ontext}\n"
      "    turn the dependents off:    ${_offtext}\n"
      "    or let CMake do the first:  -DAVER_MODULE_AUTO_DEPS=ON\n"
      "  (the dependencies are declared in each modules/<dir>/module.json; see docs/MODULES.md)")
  endif()

  # One line saying what this configuration leaves out.
  set(_off "")
  foreach(_m IN LISTS _names)
    _aver_mod_get(_opt "${_m}" option)
    if(NOT _opt STREQUAL "" AND NOT ${_opt})
      list(APPEND _off "${_opt}")
    endif()
  endforeach()
  if(_off)
    string(REPLACE ";" " " _offtext "${_off}")
    message(STATUS "Aver: optional modules OFF: ${_offtext}")
  endif()
endfunction()

# After every add_subdirectory: do the manifests describe what was actually configured?
#   - an enabled module's named target exists; a disabled module's does not
#   - every Aver.* a module's targets link belongs to the module itself or to one named in its
#     dependsOn / optionalDependsOn (or is a derived backend of it)
# FAILS rather than warns: a manifest that lies would let the launcher offer a combination that cannot
# link. dependsOn is what the dependency rule trusts, so it has to be complete.
function(aver_check_module_manifests)
  get_property(_names GLOBAL PROPERTY AVER_MOD_NAMES)
  _aver_compute_state()

  # target -> owning module, from the directory each target was defined in
  set(_dirs ${CMAKE_SOURCE_DIR})
  set(_mod_targets "")
  while(_dirs)
    list(POP_FRONT _dirs _dir)
    get_property(_subs DIRECTORY ${_dir} PROPERTY SUBDIRECTORIES)
    list(APPEND _dirs ${_subs})
    if(_dir MATCHES "^${CMAKE_SOURCE_DIR}/modules/([^/]+)$")
      set(_dname "${CMAKE_MATCH_1}")
      get_property(_tgts DIRECTORY ${_dir} PROPERTY BUILDSYSTEM_TARGETS)
      foreach(_m IN LISTS _names)
        _aver_mod_get(_mdir "${_m}" dir)
        if(_mdir STREQUAL _dname)
          foreach(_t IN LISTS _tgts)
            set(_owner_${_t} "${_m}")
          endforeach()
          set(_targets_of_${_dname} "${_tgts}")
        endif()
      endforeach()
    endif()
  endwhile()

  set(_errors "")
  foreach(_m IN LISTS _names)
    _aver_mod_get(_skel "${_m}" skeleton)
    _aver_mod_get(_here "${_m}" onThisPlatform)
    if(_skel)
      continue()
    endif()
    if(NOT _here)
      if(TARGET ${_m})
        _aver_mod_get(_mdir "${_m}" dir)
        list(APPEND _errors "${_m} is not built on ${AVER_PLATFORM_NAME} (\"platforms\" in modules/${_mdir}/module.json) but its target exists")
      endif()
      continue()
    endif()
    _aver_vid(_id "${_m}")
    _aver_mod_get(_mdir "${_m}" dir)
    _aver_mod_get(_opt "${_m}" option)
    _aver_mod_get(_req "${_m}" required)
    _aver_mod_get(_deps "${_m}" dependsOn)
    _aver_mod_get(_odeps "${_m}" optionalDependsOn)
    set(_derived OFF)
    if(NOT _req AND _opt STREQUAL "")
      set(_derived ON)
    endif()

    if(_on_${_id})
      if(NOT _derived AND NOT TARGET ${_m})
        list(APPEND _errors "${_m} is enabled but modules/${_mdir} defines no target of that name -- fix \"name\" in modules/${_mdir}/module.json, or the guard around add_subdirectory")
      endif()
    elseif(TARGET ${_m})
      if(_opt STREQUAL "")
        set(_gate "the modules in its derivedFrom")
      else()
        set(_gate "${_opt}")
      endif()
      list(APPEND _errors "${_m} is off by its manifest but its target exists -- something adds modules/${_mdir} without checking ${_gate}")
    endif()

    foreach(_t IN LISTS _targets_of_${_mdir})
      get_target_property(_type ${_t} TYPE)
      if(_type STREQUAL "UTILITY")
        continue()
      endif()
      set(_libs "")
      get_target_property(_l1 ${_t} LINK_LIBRARIES)
      get_target_property(_l2 ${_t} INTERFACE_LINK_LIBRARIES)
      if(_l1)
        list(APPEND _libs ${_l1})
      endif()
      if(_l2)
        list(APPEND _libs ${_l2})
      endif()
      foreach(_l IN LISTS _libs)
        if(NOT _l MATCHES "^Aver\\." OR NOT TARGET ${_l})
          continue()
        endif()
        set(_real "${_l}")
        get_target_property(_alias ${_l} ALIASED_TARGET)
        if(_alias)
          set(_real "${_alias}")
        endif()
        if(NOT DEFINED _owner_${_real})
          continue()
        endif()
        set(_o "${_owner_${_real}}")
        if(_o STREQUAL _m OR _o IN_LIST _deps OR _o IN_LIST _odeps)
          continue()
        endif()
        _aver_mod_get(_ofrom "${_o}" derivedFrom)
        if(_m IN_LIST _ofrom)
          continue()
        endif()
        list(APPEND _errors "${_t} links ${_l} (module ${_o}), which modules/${_mdir}/module.json does not list -- add \"${_o}\" to dependsOn (to optionalDependsOn if the link sits behind if(TARGET ...))")
      endforeach()
    endforeach()
  endforeach()

  list(REMOVE_DUPLICATES _errors)
  list(LENGTH _errors _n)
  if(_n GREATER 0)
    string(REPLACE ";" "\n    " _text "${_errors}")
    message(FATAL_ERROR "Module manifests disagree with the configured build (${_n}):\n    ${_text}\n"
                        "  The manifests are modules/<dir>/module.json; regenerate cmake/modules.catalog.json afterwards with\n"
                        "  python scripts/module-catalog.py --write")
  endif()
  message(STATUS "Aver: module manifests match the configured targets")
endfunction()

aver_load_module_manifests()
