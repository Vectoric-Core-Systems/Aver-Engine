# Finds the node palette families and writes sandbox/src/GraphNodeFamilies.gen.inc, which GraphNodeDefs.hpp
# includes. A family is a header sandbox/src/GraphNodeDefs<Family>.hpp holding
#   inline void append<Family>NodeDefs(std::vector<GraphNodeDesc>& t)
# so a new family adds that file and edits nothing shared (docs/VISUAL_SCRIPTING.md, "Adding a node family").
#
# The nine headers that existed before discovery come first, in their old order, so the palette's category menu
# keeps its order; every other header follows alphabetically. The file is rewritten only when its text changes,
# so a reconfigure does not rebuild the editor. It is generated into the source tree (and git-ignored) so no
# target needs a new include path.
#
# Included once from the root CMakeLists.txt after project().

get_filename_component(_gnf_src "${CMAKE_CURRENT_LIST_DIR}/../sandbox/src" ABSOLUTE)

if(EXISTS "${_gnf_src}/GraphNodeDefs.hpp")
  set(_gnf_legacy SynapseAi GameSystems Gas AiQuery LevelInstances Terrain Ik MotionMatch Sequencer)

  file(GLOB _gnf_found CONFIGURE_DEPENDS "${_gnf_src}/GraphNodeDefs*.hpp")
  list(SORT _gnf_found)

  set(_gnf_ordered "")
  foreach(_n IN LISTS _gnf_legacy)
    if(EXISTS "${_gnf_src}/GraphNodeDefs${_n}.hpp")
      list(APPEND _gnf_ordered "${_gnf_src}/GraphNodeDefs${_n}.hpp")
    endif()
  endforeach()
  foreach(_f IN LISTS _gnf_found)
    get_filename_component(_name "${_f}" NAME)
    if(NOT _name STREQUAL "GraphNodeDefs.hpp" AND NOT _f IN_LIST _gnf_ordered)
      list(APPEND _gnf_ordered "${_f}")
    endif()
  endforeach()

  set(_gnf_includes "")
  set(_gnf_calls "")
  foreach(_f IN LISTS _gnf_ordered)
    get_filename_component(_name "${_f}" NAME)
    file(READ "${_f}" _gnf_text)
    set(_gnf_fn "")
    if(_gnf_text MATCHES "inline void (append[A-Za-z0-9_]*NodeDefs)\\(")
      set(_gnf_fn "${CMAKE_MATCH_1}")
    endif()
    if(_gnf_fn STREQUAL "")
      message(FATAL_ERROR "Aver: ${_name} has no 'inline void append<Family>NodeDefs(' function; "
                          "every sandbox/src/GraphNodeDefs<Family>.hpp must define one (see cmake/GraphNodeFamilies.cmake)")
    endif()
    string(APPEND _gnf_includes "#include \"${_name}\"\n")
    string(APPEND _gnf_calls "    ${_gnf_fn}(t);\n")
  endforeach()

  set(_gnf_out "// generated by cmake/GraphNodeFamilies.cmake; do not edit\n")
  string(APPEND _gnf_out "${_gnf_includes}\n")
  string(APPEND _gnf_out "inline void appendAllFamilyNodeDefs(std::vector<GraphNodeDesc>& t) {\n${_gnf_calls}}\n")
  string(APPEND _gnf_out "inline void appendGeneratedFamilies(std::vector<GraphNodeDesc>& t) { appendAllFamilyNodeDefs(t); }\n")

  set(_gnf_file "${_gnf_src}/GraphNodeFamilies.gen.inc")
  set(_gnf_old "")
  if(EXISTS "${_gnf_file}")
    file(READ "${_gnf_file}" _gnf_old)
  endif()
  if(NOT _gnf_old STREQUAL _gnf_out)
    file(WRITE "${_gnf_file}" "${_gnf_out}")
  endif()
endif()
